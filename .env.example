# ============================================================
#  ExamFluent — muhit o'zgaruvchilari (environment variables)
# ============================================================
#
#  QANDAY ISHLATISH:
#  1. Shu faylni nusxalab, nomini ".env.local" qilib qo'ying.
#  2. Pastdagi qiymatlarni o'zingizning kalitlaringiz bilan to'ldiring.
#  3. ".env.local" fayli .gitignore'da — u GitHub'ga TUSHMAYDI. Bu to'g'ri.
#  4. Vercel'ga deploy qilganda shu kalitlarni Vercel > Settings >
#     Environment Variables bo'limiga QO'LDA qo'shasiz.
#
#  DIQQAT: bu kalitlarni hech kimga bermang va skrinshot qilmang.
# ============================================================


# ------------------------------------------------------------
# 1) SUPABASE — baza + auth (ro'yxatdan o'tish)
# ------------------------------------------------------------
# Qayerdan olinadi:
#   supabase.com  →  loyihangiz  →  Settings  →  API
#
# "NEXT_PUBLIC_" prefiksi nima uchun kerak?
#   Next.js'da faqat shu prefiks bilan boshlangan o'zgaruvchilar
#   brauzerga (client) uzatiladi. Supabase auth brauzerda ham
#   ishlashi kerak, shuning uchun bu ikkisi public bo'lishi shart.
#   ANON KEY public bo'lishi XAVFSIZ — chunki bazani RLS (Row Level
#   Security) qoidalari himoya qiladi (schema.sql'da yoqilgan).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# ------------------------------------------------------------
# 2) GOOGLE GEMINI — AI (chatbot, baholash, mashqlar)
# ------------------------------------------------------------
# Qayerdan olinadi:
#   https://aistudio.google.com/apikey  →  "Create API key"  (bepul)
#
# DIQQAT: bu kalitda NEXT_PUBLIC_ prefiksi YO'Q — ya'ni u faqat
# serverda qoladi va brauzerga hech qachon uzatilmaydi. Bu juda muhim,
# aks holda kimdir kalitingizni o'g'irlab, limitingizni tugatishi mumkin.

GEMINI_API_KEY=AIza....

# Ishlatiladigan model. Bepul limiti eng katta bo'lgan variant.
# Boshqa variantlar: gemini-flash-lite-latest (yanada tez, limiti kattaroq)
GEMINI_MODEL=gemini-3.6-flash


# ------------------------------------------------------------
# 3) SAYT MANZILI — auth redirect uchun
# ------------------------------------------------------------
# Lokal ishlaganda: http://localhost:3000
# Vercel'da:        https://examfluent.vercel.app  (o'z manzilingiz)

NEXT_PUBLIC_SITE_URL=http://localhost:3000
